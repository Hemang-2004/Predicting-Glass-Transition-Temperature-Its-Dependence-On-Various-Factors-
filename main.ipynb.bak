    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# ---------------- Data ----------------\n",
    "data = {\n",
    "    \"Model\": [\n",
    "        \"XGBoost\", \"Extra Trees\", \"Random Forest\", \"LightGBM\",\n",
    "        \"Decision Tree\", \"Ridge (L2)\", \"Gradient Boosting\",\n",
    "        \"KNeighbors Regressor\", \"AdaBoost\", \"Lasso (L1)\",\n",
    "        \"SVR\", \"Linear Regression\"\n",
    "    ],\n",
    "    \"MAE\": [\n",
    "        2.543406, 2.560668, 3.952508, 5.374185,\n",
    "        3.192712, 7.777737, 12.963781,\n",
    "        14.703254, 34.341569, 29.859396,\n",
    "        73.936080, 19.206078\n",
    "    ],\n",
    "    \"RMSE\": [\n",
    "        9.848225, 12.007189, 15.034838, 15.336699,\n",
    "        17.572198, 18.060835, 21.072223,\n",
    "        33.008303, 41.191658, 45.331354,\n",
    "        95.077899, 125.520693\n",
    "    ],\n",
    "    \"R2\": [\n",
    "        0.993231, 0.989938, 0.984224, 0.983585,\n",
    "        0.978450, 0.977235, 0.969011,\n",
    "        0.923961, 0.881585, 0.856588,\n",
    "        0.369117, -0.099563\n",
    "    ]\n",
    "}\n",
    "\n",
    "df = pd.DataFrame(data).set_index(\"Model\")\n",
    "\n",
    "# Sort by R2 (best models on top)\n",
    "df = df.sort_values(by=\"R2\", ascending=False)\n",
    "\n",
    "# Clip R2 only for plotting (negative bars look ugly)\n",
    "df[\"R2_plot\"] = df[\"R2\"].clip(lower=0)\n",
    "\n",
    "# ---------------- Plot ----------------\n",
    "# Option 1: Global RC params for bold text (easiest way to hit everything)\n",
    "plt.rcParams['font.weight'] = 'bold'\n",
    "plt.rcParams['axes.labelweight'] = 'bold'\n",
    "plt.rcParams['axes.titleweight'] = 'bold'\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(22, 10), sharey=True)\n",
    "\n",
    "# --- R2 ---\n",
    "sns.barplot(x=df[\"R2_plot\"], y=df.index, ax=axes[0], palette=\"viridis\")\n",
    "axes[0].set_title(\"R² Score (↑ Better)\", fontsize=20)\n",
    "axes[0].set_xlim(0, 1)\n",
    "\n",
    "# --- RMSE ---\n",
    "sns.barplot(x=df[\"RMSE\"], y=df.index, ax=axes[1], palette=\"magma_r\")\n",
    "axes[1].set_title(\"RMSE (↓ Better)\", fontsize=20)\n",
    "\n",
    "# --- MAE ---\n",
    "sns.barplot(x=df[\"MAE\"], y=df.index, ax=axes[2], palette=\"rocket_r\")\n",
    "axes[2].set_title(\"MAE (↓ Better)\", fontsize=20)\n",
    "\n",
    "# Styling\n",
    "for ax in axes:\n",
    "    ax.grid(axis=\"x\", linestyle=\"--\", alpha=0.6)\n",
    "    \n",
    "    # Increase axis label font size\n",
    "    # Using the title as the label or a custom string\n",
    "    ax.set_xlabel(ax.get_title().split('(')[0].strip(), fontsize=18, fontweight=\"bold\")\n",
    "    \n",
    "    # Increase tick label size and make them bold\n",
    "    ax.tick_params(axis='both', which='major', labelsize=14)\n",
    "    \n",
    "    # Explicitly setting tick labels to bold (redundant with rcParams but safe)\n",
    "    for label in ax.get_xticklabels() + ax.get_yticklabels():\n",
    "        label.set_fontweight('bold')\n",
    "\n",
    "# Set y-axis label specifically for the first plot\n",
    "axes[0].set_ylabel(\"Model\", fontsize=18, fontweight=\"bold\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]

   "source": [
    "### 8.4. In-Depth Analysis of Top Models\n",
    "\n",
    "Based on the initial results, models like **Extra Trees**, **Random Forest**, and **XGBoost** are the top performers. Let's analyze their predictions more closely by plotting their predicted values against the actual values."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 174,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 2000x600 with 3 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Get predictions from the top 3 models\n",
    "top_models = results_df.index[:3].tolist()\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(20, 6))\n",
    "# fig.suptitle('Actual vs. Predicted Tg for Top Models', fontsize=18)\n",
    "\n",
    "for i, model_name in enumerate(top_models):\n",
    "    model = models[model_name]\n",
    "    y_pred = model.predict(X_test_scaled)\n",
    "    \n",
    "    sns.scatterplot(x=y_test, y=y_pred, alpha=0.6, ax=axes[i], s=50)\n",
    "    axes[i].set_title(f'{model_name}\\nR2: {results[model_name][\"R2 Score\"]:.4f}', fontsize=14)\n",
    "    axes[i].set_xlabel('Actual Tg (K)', fontsize=12)\n",
    "    axes[i].set_ylabel('Predicted Tg (K)', fontsize=12)\n",
    "    \n",
    "    # Add a perfect prediction line (y=x)\n",
    "    lims = [min(y_test.min(), y_pred.min()), max(y_test.max(), y_pred.max())]\n",
    "    axes[i].plot(lims, lims, 'r--', alpha=0.75, zorder=0, label='Perfect Prediction')\n",
    "    axes[i].legend()\n",
    "    axes[i].grid(True)\n",
    "\n",
    "plt.tight_layout(rect=[0, 0, 1, 0.96])\n",
    "plt.show()"
   ]
  },

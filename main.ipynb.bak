   ],
   "source": [
    "# # Define font sizes for consistency\n",
    "# LABEL_FONTSIZE = 18\n",
    "# TICK_FONTSIZE = 18\n",
    "\n",
    "# # Set Seaborn style to \"white\" which removes the background grid\n",
    "# sns.set_style(\"white\") \n",
    "\n",
    "# # --- Correlation matrix calculation ---\n",
    "# # This part remains the same\n",
    "# numerical_features = df.select_dtypes(include=['int64', 'float64']).columns.tolist()\n",
    "# correlation_matrix = df[numerical_features].corr()\n",
    "\n",
    "# # --- Plot correlation matrix ---\n",
    "# plt.figure(figsize=(16, 14))\n",
    "\n",
    "# # MOD: Call heatmap and capture the returned Axes object in 'ax'\n",
    "# # ax = sns.heatmap(\n",
    "# #     correlation_matrix, \n",
    "# #     annot=True, \n",
    "# #     cmap='coolwarm', \n",
    "# #     fmt='.2f', \n",
    "# #     linewidths=0  # MOD: Set to 0 to remove grid lines between cells\n",
    "# # )\n",
    "# ax = sns.heatmap(\n",
    "#     correlation_matrix, \n",
    "#     annot=True, \n",
    "#     annot_kws={\"weight\": \"bold\"},  # <-- Bold numbers\n",
    "#     cmap='coolwarm', \n",
    "#     fmt='.2f', \n",
    "#     linewidths=1,                  # <-- Darker borders between cells\n",
    "#     linecolor='black'              # <-- Border color\n",
    "# )\n",
    "\n",
    "\n",
    "# # plt.title('Correlation Matrix of Numerical Features') # MOD: Title removed\n",
    "\n",
    "# # MOD: Increase font size of x and y axis tick labels (which are the feature names)\n",
    "# # MOD: Added rotation to x-ticks for better readability if names are long\n",
    "# # plt.xticks(fontsize=TICK_FONTSIZE, rotation=90) \n",
    "# # plt.yticks(fontsize=TICK_FONTSIZE, rotation=0)\n",
    "# plt.xticks(fontsize=TICK_FONTSIZE, rotation=90, fontweight='bold')\n",
    "# plt.yticks(fontsize=TICK_FONTSIZE, rotation=0, fontweight='bold')\n",
    "\n",
    "\n",
    "# # MOD: Adjust the colorbar (\"legend\") tick label size\n",
    "# cbar = ax.collections[0].colorbar\n",
    "# cbar.ax.tick_params(labelsize=TICK_FONTSIZE)\n",
    "\n",
    "# plt.tight_layout()\n",
    "# plt.show()\n",
    "\n",
    "# # --- Identify highly correlated features ---\n",
    "# # This part remains the same\n",
    "# high_corr = []\n",
    "# for i in range(len(correlation_matrix.columns)):\n",
    "#     for j in range(i):\n",
    "#         if abs(correlation_matrix.iloc[i, j]) > 0.7:\n",
    "#             high_corr.append((correlation_matrix.columns[i], correlation_matrix.columns[j], correlation_matrix.iloc[i, j]))\n",
    "\n",
    "# if high_corr:\n",
    "#     print(\"Highly correlated features (|correlation| > 0.7):\")\n",
    "#     for feat1, feat2, corr in high_corr:\n",
    "#         print(f\"{feat1} and {feat2}: {corr:.4f}\")\n",
    "# else:\n",
    "#     print(\"No highly correlated features found (|correlation| > 0.7).\")\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# --- Mock Data ---\n",
    "# This data is mocked based on your image to make the script runnable\n",
    "# In your code, you'll already have 'df'\n",
    "columns = [\n",
    "    'mn', 'mw', 'tg', 'dens', 'temperature', 'dielectric_constant',\n",
    "    'molar_refractivity', 'radius_of_gyration_square', 'branching',\n",
    "    'solvent_mol_wt', 'solvent_mol_mr', 'solvent_tpsa', \n",
    "    'solvent_h_donors', 'solvent_h_acceptors'\n",
    "]\n",
    "np.random.seed(42)\n",
    "df1 = pd.DataFrame(np.random.rand(50, len(columns)), columns=columns)\n",
    "# --- End of Mock Data ---\n",
    "\n",
    "\n",
    "# Define font sizes for consistency\n",
    "LABEL_FONTSIZE = 18\n",
    "TICK_FONTSIZE = 18\n",
    "\n",
    "# Set Seaborn style to \"white\" which removes the background grid\n",
    "sns.set_style(\"white\") \n",
    "\n",
    "# --- Correlation matrix calculation ---\n",
    "numerical_features = df1.select_dtypes(include=['int64', 'float64']).columns.tolist()\n",
    "correlation_matrix = df1[numerical_features].corr()\n",
    "\n",
    "# --- Create custom labels ---\n",
    "# Define a dictionary to map original names to new, shorter names.\n",
    "# We use LaTeX-style strings (e.g., r'$...$') for subscripts and superscripts.\n",
    "label_map = {\n",
    "    'temperature': 'temp',\n",
    "    'molar_refractivity': r'$R_m$',  # Will be rendered as R with subscript m\n",
    "    'radius_of_gyration_square': r'$R_g^2$' # Will be rendered as Rg with superscript 2\n",
    "}\n",
    "\n",
    "# Get the original column names\n",
    "original_labels = correlation_matrix.columns\n",
    "\n",
    "# Create the new list of labels, applying the map\n",
    "# .get(label, label) means: \"Try to get the new label from the map.\n",
    "# If it's not in the map, just use the original label.\"\n",
    "new_labels = [label_map.get(label, label) for label in original_labels]\n",
    "\n",
    "\n",
    "# --- Plot correlation matrix ---\n",
    "plt.figure(figsize=(16, 14))\n",
    "\n",
    "ax = sns.heatmap(\n",
    "    correlation_matrix, \n",
    "    annot=True, \n",
    "    annot_kws={\"weight\": \"bold\"},   # Bold numbers\n",
    "    cmap='coolwarm', \n",
    "    fmt='.2f', \n",
    "    linewidths=1,                   # Darker borders between cells\n",
    "    linecolor='black',              # Border color\n",
    "    xticklabels=new_labels,         # MOD: Use new custom labels for x-axis\n",
    "    yticklabels=new_labels          # MOD: Use new custom labels for y-axis\n",
    ")\n",
    "\n",
    "# Increase font size/weight of x and y axis tick labels\n",
    "plt.xticks(fontsize=TICK_FONTSIZE, rotation=90, fontweight='bold')\n",
    "plt.yticks(fontsize=TICK_FONTSIZE, rotation=0, fontweight='bold')\n",
    "\n",
    "# Adjust the colorbar (\"legend\") tick label size\n",
    "cbar = ax.collections[0].colorbar\n",
    "cbar.ax.tick_params(labelsize=TICK_FONTSIZE)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# --- Identify highly correlated features ---\n",
    "# This part remains the same (it works on the original matrix)\n",
    "high_corr = []\n",
    "for i in range(len(correlation_matrix.columns)):\n",
    "    for j in range(i):\n",
    "        if abs(correlation_matrix.iloc[i, j]) > 0.7:\n",
    "            # Report the original, full feature names\n",
    "            feat1 = correlation_matrix.columns[i]\n",
    "            feat2 = correlation_matrix.columns[j]\n",
    "            corr_val = correlation_matrix.iloc[i, j]\n",
    "            high_corr.append((feat1, feat2, corr_val))\n",
    "\n",
    "if high_corr:\n",
    "    print(\"Highly correlated features (|correlation| > 0.7):\")\n",
    "    for feat1, feat2, corr in high_corr:\n",
    "        print(f\"{feat1} and {feat2}: {corr:.4f}\")\n",
    "else:\n",
    "    print(\"No highly correlated features found (|correlation| > 0.7).\")"
   ]
  },
